# ==============================================================================
# Microsoft Active Directory MCP Server - Environment Configuration
# ==============================================================================

# Operation Mode: READ_ONLY (Default), WRITE_APPROVAL, or FULL_ADMIN
AD_MCP_MODE=READ_ONLY

# Active Directory Domain and Controller Settings
AD_SERVER=dc01.corp.contoso.com
AD_DOMAIN=corp.contoso.com
AD_PORT=636
AD_USE_SSL=true
AD_TLS_VALIDATE_CERT=true

# ------------------------------------------------------------------------------
# ENTERPRISE PRODUCTION AUTHENTICATION (NO PLAINTEXT PASSWORDS ON DISK)
# ------------------------------------------------------------------------------
# Option 1 (Recommended on Windows Domain): Use Windows Integrated Auth (Kerberos/SSPI)
# AD_AUTH_METHOD=windows_integrated
# (Leave username and password blank! Windows authenticates seamlessly via Kerberos)

# Option 2: Use Windows Credential Manager (Encrypted OS-level vault via DPAPI)
AD_AUTH_METHOD=credential_manager
AD_CREDENTIAL_TARGET=AD_MCP_CREDENTIAL
# (Run: powershell -File scripts/set_production_credentials.ps1 to encrypt the password once)

# Option 3 (Lab / Containers only): Direct Environment Variables
# AD_AUTH_METHOD=env
# AD_USERNAME=CONTOSO\svc_ad_mcp
# AD_PASSWORD=YourPasswordOnlyInSecureCIOrMemory

# ------------------------------------------------------------------------------
# Security & Safety Guardrails
# ------------------------------------------------------------------------------
AD_PROTECT_CRITICAL_OBJECTS=true
AD_ALLOW_DESTRUCTIVE_OPERATIONS=false
AD_ALLOW_BULK_OPERATIONS=false
AD_APPROVAL_TOKEN_TTL_SECONDS=300

# Performance & Integration Backend
AD_BACKEND=hybrid
AD_TIMEOUT_SECONDS=30
AD_MAX_PAGE_SIZE=1000

# Audit Logging & Reports
AD_AUDIT_LOG_FILE=logs/ad_audit.jsonl
AD_REPORT_OUTPUT_DIR=reports_output
