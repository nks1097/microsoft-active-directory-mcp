# ==============================================================================
# Microsoft Active Directory MCP Server - Environment Configuration
# ==============================================================================

# Operation Mode: READ_ONLY (Default), WRITE_APPROVAL, or FULL_ADMIN
AD_MCP_MODE=READ_ONLY

# Active Directory Domain and Controller Settings
AD_SERVER=192.168.0.201
AD_DOMAIN=nks1097.local
AD_PORT=389
AD_USE_SSL=false

# Service Account Credentials (DOMAIN\username or user@domain.local)
# In production, use dedicated service accounts with least privilege delegations.
AD_USERNAME=nks1097\Administrator
AD_PASSWORD=YourStrongServiceAccountPasswordHere

# Base DN (Default Naming Context) - Auto-computed from AD_DOMAIN if omitted
# AD_BASE_DN=DC=nks1097,DC=local

# Security & Safety Guardrails
AD_PROTECT_CRITICAL_OBJECTS=true
AD_ALLOW_DESTRUCTIVE_OPERATIONS=false
AD_ALLOW_BULK_OPERATIONS=false
AD_APPROVAL_TOKEN_TTL_SECONDS=300

# Performance & Integration Backend
# Options: 'hybrid' (PowerShell on Windows, LDAP on Linux), 'powershell', or 'ldap'
AD_BACKEND=hybrid
AD_TIMEOUT_SECONDS=30
AD_MAX_PAGE_SIZE=1000

# Audit Logging & Reports
AD_AUDIT_LOG_FILE=logs/ad_audit.jsonl
AD_REPORT_OUTPUT_DIR=reports_output

# Custom PowerShell executable path (Optional: auto-detects pwsh / powershell.exe)
# AD_POWERSHELL_PATH=C:\Program Files\PowerShell\7\pwsh.exe

